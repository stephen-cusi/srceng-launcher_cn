<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="SrcEng.MD3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorOnTertiary">@color/md3_on_tertiary</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorOutlineVariant">@color/md3_outline_variant</item>
        <item name="android:windowBackground">@color/md3_surface</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:navigationBarColor">@color/md3_surface_container_highest</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
    </style>

    <style name="SrcEng.MD3.Dark" parent="SrcEng.MD3">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SrcEng.DialogPreview" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_preview_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_preview_exit</item>
    </style>

    <!--
        Material 3 Expressive 字阶 (type scale)。
        字号/字距/行高按 M3 规范给出；带 .Emphasized 后缀的为 Expressive 新增的强调字重，
        用于需要视觉重量的标题与操作项。颜色不在此定义，由 Md3Theme 运行时按 token 覆盖。
    -->
    <style name="Expressive" />

    <style name="Expressive.Display" tools:ignore="UnusedResources" />

    <style name="Expressive.Display.Small" tools:ignore="UnusedResources">
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.22</item>
    </style>

    <style name="Expressive.Headline" />

    <style name="Expressive.Headline.Medium">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.29</item>
    </style>

    <style name="Expressive.Headline.Medium.Emphasized">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Headline.Small" tools:ignore="UnusedResources">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.33</item>
    </style>

    <style name="Expressive.Headline.Small.Emphasized" tools:ignore="UnusedResources">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Title" />

    <style name="Expressive.Title.Large" tools:ignore="UnusedResources">
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.27</item>
    </style>

    <style name="Expressive.Title.Large.Emphasized" tools:ignore="UnusedResources">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Title.Medium">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.009</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="Expressive.Title.Medium.Emphasized">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Title.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:lineSpacingMultiplier">1.43</item>
    </style>

    <style name="Expressive.Title.Small.Emphasized">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Body" />

    <style name="Expressive.Body.Large">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.031</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="Expressive.Body.Medium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.018</item>
        <item name="android:lineSpacingMultiplier">1.43</item>
    </style>

    <style name="Expressive.Body.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.033</item>
        <item name="android:lineSpacingMultiplier">1.33</item>
    </style>

    <style name="Expressive.Label" />

    <style name="Expressive.Label.Large">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:lineSpacingMultiplier">1.43</item>
    </style>

    <style name="Expressive.Label.Large.Emphasized">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Label.Medium" tools:ignore="UnusedResources">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.042</item>
        <item name="android:lineSpacingMultiplier">1.33</item>
    </style>

    <style name="Expressive.Label.Medium.Emphasized" tools:ignore="UnusedResources">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Expressive.Label.Small" tools:ignore="UnusedResources">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.045</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

</resources>
