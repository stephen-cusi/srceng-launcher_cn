<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/engine_log_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/md3_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="32dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/md3_button_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/md3_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tag="icon" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/engine_log_filter"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/engine_log_filter"
            android:src="@drawable/ic_filter_list"
            android:tag="icon" />

        <ImageButton
            android:id="@+id/engine_log_menu"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/engine_log_menu"
            android:src="@drawable/ic_more_vert"
            android:tag="icon" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/engine_log_file_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="4dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/engine_log_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="engine.log"
            android:textAppearance="@style/Expressive.Headline.Small.Emphasized" />

        <TextView
            android:id="@+id/engine_log_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:tag="subtitle"
            android:textAppearance="@style/Expressive.Body.Small" />
    </LinearLayout>

    <TextView
        android:id="@+id/engine_log_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:tag="subtitle"
        android:textAppearance="@style/Expressive.Body.Small"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/engine_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:id="@+id/engine_log_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:id="@+id/engine_log_horizontal_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">

                <!-- 日志正文是等宽代码，不套字阶，保持逐字对齐。 -->
                <me.nillerusr.EngineLogTextView
                    android:id="@+id/engine_log_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </HorizontalScrollView>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
