<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <LinearLayout
        android:id="@+id/md3_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="44dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/md3_button_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/md3_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tag="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/engine_log_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_log_viewer"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/engine_log_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textSize="12sp"
                android:tag="subtitle" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/engine_log_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:tag="tonal"
            android:text="@string/engine_log_refresh" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/engine_log_filter_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/md3_app_bar"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/engine_log_filter_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_log_filter_all" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/engine_log_filter_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_log_filter_error" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/engine_log_filter_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_log_filter_warning" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/engine_log_filter_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_log_filter_info" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/engine_log_status_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/engine_log_filter_group"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/engine_log_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textSize="12sp"
            android:tag="subtitle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/engine_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/engine_log_status_area"
        android:fillViewport="true"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/engine_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="24dp"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>
</RelativeLayout>
