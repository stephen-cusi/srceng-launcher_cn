<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp"
        android:paddingTop="0dp">

        <!-- ========== Top App Bar ========== -->
        <LinearLayout
            android:id="@+id/md3_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="44dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/md3_button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="centerInside"
                android:background="@drawable/md3_btn_icon"
                android:contentDescription="@string/md3_back"
                android:tag="icon"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="@string/md3_settings"
                android:textStyle="bold"
                android:textSize="22sp"
                android:maxLines="1"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/md3_section_navigation"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:tag="primary" />

        <!-- ========== Language section (before Look & Feel) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_language"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <!-- Launcher UI language -->
        <LinearLayout
            android:id="@+id/md3_lang_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_ui_language"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_ui_lang_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/md3_ui_lang_spinner"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fontFamily="sans"
                android:gravity="start|center_vertical"
                android:includeFontPadding="true"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:tag="outlined"/>
        </LinearLayout>

        <!-- In-game language -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card_outlined">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_game_language"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_game_lang_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/md3_game_lang_spinner"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fontFamily="sans"
                android:gravity="start|center_vertical"
                android:includeFontPadding="true"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:tag="outlined"/>
        </LinearLayout>

        <!-- ========== Game section title (resolution goes here) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_game"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <!-- Resolution mode card -->
        <LinearLayout
            android:id="@+id/md3_res_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_resolution"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_resolution_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Mode radio group: Device native / Preset / Custom -->
            <RadioGroup
                android:id="@+id/md3_res_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_res_mode_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_mode_default"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_res_mode_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_mode_device"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_res_mode_preset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_mode_preset"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_res_mode_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_mode_custom"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
            </RadioGroup>

            <!-- Preset spinner (only visible when PRESET mode selected) -->
            <LinearLayout
                android:id="@+id/md3_res_preset_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_preset_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/md3_res_preset_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:tag="outlined"/>
            </LinearLayout>

            <!-- Custom width/height (only visible when CUSTOM mode selected) -->
            <LinearLayout
                android:id="@+id/md3_res_custom_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_res_custom_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/md3_res_width"
                            android:textSize="12sp"
                            android:tag="subtitle"
                            android:layout_marginBottom="2dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/md3_res_custom_w"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:hint="1280"
                                android:imeOptions="actionNext"
                                android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/md3_res_height"
                            android:textSize="12sp"
                            android:tag="subtitle"
                            android:layout_marginBottom="2dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/md3_res_custom_h"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:hint="720"
                                android:imeOptions="actionDone"
                                android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Skip intro video -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_skip_intro_video"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/md3_skip_intro_video_desc"
                    android:textSize="12sp"
                    android:tag="subtitle"/>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/md3_skip_intro_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Disable background map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_no_background_level"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/md3_no_background_level_desc"
                    android:textSize="12sp"
                    android:tag="subtitle"/>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/md3_no_background_level_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- ========== Updates ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_updates"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card_outlined">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/md3_update_channel" android:textStyle="bold" android:textSize="16sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/md3_update_channel_desc" android:textSize="12sp" android:layout_marginTop="4dp" android:tag="subtitle"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/md3_update_channel" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:tag="outlined"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/md3_update_mirror" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/md3_update_mirror_desc" android:textSize="12sp" android:layout_marginTop="4dp" android:tag="subtitle"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/md3_update_mirror" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:tag="outlined"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/md3_test_mirrors" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/md3_update_mirror_test" android:tag="outlined"/>
            <TextView android:id="@+id/md3_mirror_test_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/md3_update_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:tag="subtitle"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/md3_check_update" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/md3_update_check" android:tag="filled"/>
        </LinearLayout>

        <!-- ========== Tools ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"
            android:text="@string/md3_section_tools"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/md3_vpk_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card_outlined">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vpk_tool"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:tag="subtitle"
                android:text="@string/vpk_tool_desc"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/md3_engine_log_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="card_outlined">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_log_viewer"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:tag="subtitle"
                android:text="@string/engine_log_viewer_desc"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ========== Appearance section title ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_look"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <!-- Dark mode row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_mode"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/md3_dark_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_dark_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_follow_system"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_dark_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_off"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/md3_dark_on"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_on"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_amoled_black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_amoled_black_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/md3_amoled_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic color row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card_outlined">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_dynamic_color"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_dynamic_color_desc"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:tag="subtitle"/>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/md3_dynamic_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Static seed color selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/md3_seed_color"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/md3_seed_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start"/>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/md3_seed_custom_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_custom_color"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/md3_seed_custom_preview"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/md3_seed_hex"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/md3_hex_color_hint"
                            android:inputType="textCapCharacters"
                            android:maxLength="7"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="R"/>
                    <SeekBar android:id="@+id/md3_seed_red" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="255"/>
                    <TextView android:id="@+id/md3_seed_red_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="G"/>
                    <SeekBar android:id="@+id/md3_seed_green" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="255"/>
                    <TextView android:id="@+id/md3_seed_green_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="B"/>
                    <SeekBar android:id="@+id/md3_seed_blue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="255"/>
                    <TextView android:id="@+id/md3_seed_blue_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
