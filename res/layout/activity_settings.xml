<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="32dp"
        android:paddingTop="0dp">

        <!-- ========== Top App Bar ========== -->
        <LinearLayout
            android:id="@+id/md3_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="44dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/md3_button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_revert"
                android:scaleType="centerInside"
                android:background="@drawable/md3_btn_icon"
                android:contentDescription="@string/md3_back"
                android:tag="icon"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="@string/md3_settings"
                android:textStyle="bold"
                android:textSize="22sp"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- ========== Language section (before Look & Feel) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_language"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <!-- Launcher UI language (Spinner: 10 languages) -->
        <LinearLayout
            android:id="@+id/md3_lang_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_ui_language"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_ui_lang_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
            </LinearLayout>
            <Spinner
                android:id="@+id/md3_ui_lang_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog"/>
        </LinearLayout>

        <!-- In-game language -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card_outlined">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_game_language"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/md3_game_lang_desc"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:tag="subtitle"/>
                </LinearLayout>
            </LinearLayout>
            <Spinner
                android:id="@+id/md3_game_lang_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog"/>
        </LinearLayout>

        <!-- ========== Appearance section title ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_section_look"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <!-- Dark mode row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_mode"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/md3_dark_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/md3_dark_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_follow_system"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <RadioButton
                    android:id="@+id/md3_dark_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_off"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
                <RadioButton
                    android:id="@+id/md3_dark_on"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/md3_dark_on"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Dynamic color row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card_outlined">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_dynamic_color"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_dynamic_color_desc"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:tag="subtitle"/>
            </LinearLayout>
            <Switch
                android:id="@+id/md3_dynamic_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Static seed color selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:tag="card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/md3_seed_color"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/md3_seed_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">
                <!-- 4 seed color dots will be appended at runtime -->
            </LinearLayout>
        </LinearLayout>

        <!-- ========== Preview ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/md3_preview"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:tag="primary"/>

        <LinearLayout
            android:id="@+id/md3_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="32dp"
            android:tag="preview_primary">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/md3_preview"
                android:textStyle="bold"
                android:textSize="16sp"
                android:tag="on_primary_container"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/md3_preview_text"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:tag="on_primary_container"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button
                    android:id="@+id/md3_preview_btn_filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_preview_primary"
                    android:textSize="13sp"
                    android:tag="filled"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/md3_preview_btn_tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_preview_secondary"
                    android:textSize="13sp"
                    android:tag="tonal"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/md3_preview_btn_outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/md3_preview_outlined"
                    android:textSize="13sp"
                    android:tag="outlined"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
