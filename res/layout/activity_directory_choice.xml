<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/directory_choice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:id="@+id/md3_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/md3_button_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/md3_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tag="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/srceng_launcher_set_game_path"
                android:textAppearance="@style/Expressive.Headline.Small.Emphasized" />

            <TextView
                android:id="@+id/header_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="start"
                android:maxLines="1"
                android:tag="subtitle"
                android:text="@string/srceng_dir_storage_prompt"
                android:textAppearance="@style/Expressive.Body.Small" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/directory_choice_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:tag="subtitle"
            android:text="@string/srceng_dir_storage_prompt"
            android:textAppearance="@style/Expressive.Body.Small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_choice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:enabled="false"
            android:tag="filled"
            android:text="@string/srceng_dir_choice_btn"
            android:textAppearance="@style/Expressive.Title.Medium.Emphasized" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/directory_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footer2"
        android:layout_below="@id/md3_app_bar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/bodych"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</RelativeLayout>
