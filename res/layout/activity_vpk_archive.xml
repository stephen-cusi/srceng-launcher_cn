<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <LinearLayout
        android:id="@+id/md3_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="44dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/md3_button_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/md3_back"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_revert"
            android:tag="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vpk_archive_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vpk_archive_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:textSize="12sp"
                android:tag="subtitle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vpk_archive_status_area"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/md3_app_bar"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/vpk_archive_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="12sp"
            android:tag="subtitle" />

        <ProgressBar
            android:id="@+id/vpk_archive_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/vpk_archive_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/vpk_archive_footer"
        android:layout_below="@id/vpk_archive_status_area"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/vpk_archive_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/vpk_archive_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/vpk_archive_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vpk_archive_extract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vpk_extract_selected" />
    </LinearLayout>
</RelativeLayout>
