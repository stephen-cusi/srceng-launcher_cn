<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpk_archive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <LinearLayout
        android:id="@+id/md3_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/md3_button_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/md3_btn_icon"
            android:contentDescription="@string/md3_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tag="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vpk_archive_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="@style/Expressive.Headline.Small.Emphasized" />

            <TextView
                android:id="@+id/vpk_archive_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="start"
                android:maxLines="1"
                android:tag="subtitle"
                android:textAppearance="@style/Expressive.Body.Small" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vpk_archive_status_area"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/md3_app_bar"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/vpk_archive_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:tag="subtitle"
            android:textAppearance="@style/Expressive.Body.Small" />

        <ProgressBar
            android:id="@+id/vpk_archive_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/vpk_archive_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/vpk_archive_footer"
        android:layout_below="@id/vpk_archive_status_area"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/vpk_archive_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/vpk_archive_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/vpk_archive_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:tag="subtitle"
            android:textAppearance="@style/Expressive.Body.Medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vpk_archive_extract"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/vpk_extract_selected" />
    </LinearLayout>
</RelativeLayout>
